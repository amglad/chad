# Copy this file to .env (cp .env.example .env) and fill in real values.
# .env is ignored by git so your key stays on the Pi.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=put-your-key-here

# Optional settings (the defaults are shown)
# CHAT_MODEL=gemini-3.5-flash-lite   # or gemini-3.8-flash (smarter, slower, pricier)
# THINKING_LEVEL=minimal             # minimal / low / medium / high
# TTS_MODEL=gemini-3.8-flash-tts   # see scripts/list_models.py for options
# TTS_ENGINE=piper           # "piper" (free, offline), "gemini", or "espeak" (robot)
# PIPER_VOICE=en_US-ryan-medium     # other male voices: en_US-joe-medium, en_GB-alan-medium; faster: en_US-ryan-low
# VOICE_EFFECT=deep          # deep, alien, warble, squeaky, wobbly, tiny, none (or your own sox effects)
# SPEED=1.0                  # bigger = slower, e.g. 1.15 if the alien voice is hard to follow
# VOICE=Puck                 # Gemini voice (only with TTS_ENGINE=gemini)
# VOICE_STYLE=upbeat, energetic and friendly
# USE_SEARCH=true            # Google Search for current events (needs a paid-tier key;
#                            # Chad turns it off automatically if it isn't allowed)
